    "@nestjs/observe": "^0.1.8",
    "@nestjs/platform-express": "^12.0.1",
    "canonical-json": "^0.4.0",
    "decimal.js": "^10.6.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@mikro-orm/cli": "7.1.14",
