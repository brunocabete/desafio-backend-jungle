# Local development environment. Copy to .env and adjust.
# Credentials below are for local Docker Compose services only (never real secrets).

# Postgres — read by compose.yml (overrides its ${VAR:-default} values)
POSTGRES_DB=myapp
POSTGRES_USER=myapp
POSTGRES_PASSWORD=secret
POSTGRES_PORT=5432

# App DB connection
DATABASE_HOST=localhost
DATABASE_PORT=5432

# MiniStack (local AWS/SQS emulator on :4566)
AWS_ENDPOINT_URL=http://localhost:4566
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Main SQS input queue (FIFO) created by docker/ministack/init/01-create-queues.sh
AWS_SQS_QUEUE=wager-transactions.fifo
